FLASK_SECRET_KEY=<gere um valor aleatorio longo>
APP_HOST=0.0.0.0
APP_PORT=4732
APP_DEBUG=false
SIENGE_SESSION_REUSE_ENABLED=true
SELENIUM_REPORT_WAIT_SECONDS=5
SELENIUM_DOWNLOAD_WAIT_TIMEOUT_SECONDS=120
