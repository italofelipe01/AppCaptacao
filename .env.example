# =====================================================================
# AppCaptacao - lista canonica de variaveis de ambiente
# ---------------------------------------------------------------------
# Desenvolvimento: copie para ".env" na raiz do repositorio e preencha.
# Executavel: use o ConfigurarAppCaptacao.exe, que grava a configuracao
# criptografada (DPAPI) em %LOCALAPPDATA%\AppCaptacao\app_captacao.env.enc.
# Nunca faca commit do .env preenchido.
# Linhas comentadas mostram o valor padrao usado quando a variavel falta.
# =====================================================================

# --- Aplicacao web ---------------------------------------------------
# Chave que assina o cookie de sessao. Gere um valor longo e aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=
# 127.0.0.1 = so esta maquina. 0.0.0.0 expoe o app para a rede inteira.
APP_HOST=127.0.0.1
APP_PORT=4732
APP_DEBUG=false
# APP_LAUNCH_URL=/

# --- Banco SQL Server --------------------------------------------------
DB_DRIVER=SQL Server
DB_HOST=
DB_DATABASE=
# Legado: DB_SCHEMA so vira nome do banco quando DB_DATABASE nao existe no arquivo.
# DB_SCHEMA=
DB_USER=
DB_PASSWORD=
# Parametros extras do ODBC separados por ";" (ex.: TrustServerCertificate=yes)
DB_EXTRA_PARAMS=
DB_TIMEOUT=5

# --- Tabelas (schema.tabela) -------------------------------------------
# USUARIO_TABLE=dbo.CapRecursoUsuario
# OPERACAO_TABLE=dbo.CapRecursoOperacoes
# RELATORIO_TABLE=dbo.CapRecursoRelatorio
# RELATORIO_X_OPERACAO_TABLE=dbo.CapRecursoRelatorio_X_Operacao
# FILTRO_CATALOGO_TABLE=dbo.CapRecursoFiltro
# FILTRO_X_OPERACAO_TABLE=dbo.CapRecursoFiltro_X_Operacao
# LOG_CONFIG_TABLE=dbo.CapRecursoLogConfiguracao
# LOG_OPERACAO_TABLE=dbo.CapRecursoLogOperacao

# --- Logs persistidos no banco -----------------------------------------
# Pausados por padrao. true volta a gravar logs de configuracao e de operacao.
APP_SAVE_LOGS=false

# --- Consolidacao dos relatorios ----------------------------------------
# No fim da execucao, cada relatorio baixado ganha <Relatorio>_consolidado_<data>.xlsx na pasta
# dele, conferido com os totais do Sienge. false desliga (os arquivos continuam nas pastas).
APP_CONSOLIDAR_RELATORIOS=true

# --- Sienge e navegador (Selenium) -------------------------------------
SIENGE_LOGIN_URL=https://ebm.sienge.com.br/sienge/
# edge (padrao) ou chrome. Nao ha troca automatica se o navegador falhar.
SELENIUM_BROWSER=edge
SELENIUM_KEEP_BROWSER_OPEN=false
# Edge: anexa a uma janela normal aberta com porta de depuracao (padrao true).
# SELENIUM_ATTACH_NORMAL_EDGE=true
# SELENIUM_EDGE_DEBUG_HOST=127.0.0.1
# SELENIUM_EDGE_DEBUG_PORT=9223
EDGE_USE_PROFILE=true
# Vazio = perfil exclusivo da automacao em %LOCALAPPDATA%\AppCaptacao\state
EDGE_USER_DATA_DIR=
EDGE_PROFILE_DIRECTORY=Default
# Chrome (so quando SELENIUM_BROWSER=chrome)
# SELENIUM_ATTACH_NORMAL_CHROME=false
# SELENIUM_CHROME_DEBUG_HOST=127.0.0.1
# SELENIUM_CHROME_DEBUG_PORT=9222
# CHROME_USER_DATA_DIR=
# CHROME_PROFILE_DIRECTORY=
# Salva cookies da sessao apos login interativo (a sessao salva nao e restaurada).
SIENGE_SESSION_REUSE_ENABLED=true

# --- Tempos da automacao (segundos) -----------------------------------
# SELENIUM_DEFAULT_TIMEOUT=20
# SELENIUM_REPORT_WAIT_SECONDS=5
# SELENIUM_POST_LOGIN_WAIT_SECONDS=8
# Prazo para aprovar o MFA (Authenticator) na tela da Microsoft.
# SELENIUM_MICROSOFT_MFA_WAIT_SECONDS=60
# Prazo para concluir o login a mao quando o automatico nao consegue.
# SIENGE_INTERACTIVE_LOGIN_TIMEOUT_SECONDS=180

# --- Downloads ---------------------------------------------------------
# Vazio = %USERPROFILE%\Downloads\Automação CAP
SELENIUM_DOWNLOAD_DIR=
# SELENIUM_DOWNLOAD_WAIT_TIMEOUT_SECONDS=600
# SELENIUM_DOWNLOAD_STABLE_CYCLES=3
# SELENIUM_DOWNLOAD_QUIET_PERIOD_SECONDS=2.5
# Temporario parado ha mais que isto (download interrompido) nao trava a espera da pasta.
# SELENIUM_DOWNLOAD_STALE_TEMP_SECONDS=300
# true salva print e HTML da tela em <pasta de downloads>\_debug_selenium
# SELENIUM_DEBUG_ARTIFACTS=false

# --- Admin local de desenvolvimento ------------------------------------
# Login sem banco, so para desenvolvimento. Exige o hash da senha:
#   python -c "from werkzeug.security import generate_password_hash as h; print(h('sua-senha'))"
DEV_BOOTSTRAP_ADMIN_ENABLED=false
DEV_BOOTSTRAP_ADMIN_LOGIN=admin
DEV_BOOTSTRAP_ADMIN_PASSWORD_HASH=
# DEV_BOOTSTRAP_ADMIN_ID=999999
# DEV_BOOTSTRAP_ADMIN_EMAIL=admin@local.test
# DEV_BOOTSTRAP_ADMIN_AREA=performance
# DEV_BOOTSTRAP_ADMIN_ACCESS_ID=1

# --- Autenticacao de rede Windows (implementada, ainda nao ligada ao login) ---
# NETWORK_AUTH_DOMAIN=
# NETWORK_AUTH_DEFAULT_ACCESS_ID=3
# NETWORK_AUTH_DEFAULT_AREA=rede
# NETWORK_AUTH_SYNTHETIC_USER_ID=0

# --- Local da configuracao ---------------------------------------------
# Pasta alternativa para app_captacao.env(.enc); padrao %LOCALAPPDATA%\AppCaptacao
# APP_CAPTACAO_CONFIG_DIR=
# Permite .env em texto puro no executavel (nao recomendado)
# APP_CAPTACAO_ALLOW_PLAINTEXT_ENV=false
